{
  "rules": {
    ".read": false,
    ".write": false,
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "credit_settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "rates": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "About_Us": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "cancel_reason": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "referral": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "offers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$offerId": {
        "user_avail": {
          ".write": "auth != null"
        }
      }
    },
    "bookings": {
      ".indexOn": ["status"],
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "chat": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".indexOn": ["usertype"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null",
        "isAdmin": {
          ".validate": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
        },
        "approved": {
          ".validate": "newData.val() === false || root.child('users').child(auth.uid).child('isAdmin').val() === true"
        },
        "usertype": {
          ".validate": "(auth.uid === $uid && (newData.val() === 'rider' || newData.val() === 'driver')) || root.child('users').child(auth.uid).child('isAdmin').val() === true"
        },
        "my_bookings": {
          ".validate": true
        },
        "my-booking": {
          ".validate": true
        },
        "waiting_riders_list": {
          ".validate": true
        },
        "queue": {
          ".validate": true
        },
        "ratings": {
          ".validate": true
        },
        "$other": {
          ".validate": "auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true"
        },
        "walletBalance": {
          ".validate": "root.child('users').child(auth.uid).child('isAdmin').val() === true || (auth.uid === $uid && root.child('users').child($uid).child('usertype').val() !== 'driver')"
        },
        "walletHistory": {
          ".validate": "root.child('users').child(auth.uid).child('isAdmin').val() === true || (auth.uid === $uid && root.child('users').child($uid).child('usertype').val() !== 'driver')",
          ".indexOn": ["date"]
        }
      }
    },
    "waveRidePayments": {
      "$sessionId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "orangeRidePayments": {
      "$reference": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "orangeTokens": {
      ".read": false,
      ".write": false
    },
    "walletTopups": {
      "$sessionId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "driverPayouts": {
      "$payoutId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },
    "sos_alerts": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      ".indexOn": ["driver"],
      "$alerteId": {
        ".write": "auth != null && !data.exists() && newData.child('driver').val() === auth.uid",
        ".validate": "newData.hasChildren(['driver', 'destinataire', 'at'])",
        "driver": {
          ".validate": "newData.val() === auth.uid"
        },
        "destinataire": {
          ".validate": "newData.isString() && (newData.val() === 'secours' || newData.val() === 'heeroo')"
        },
        "numero": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "pays": {
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "bookingId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "plateforme": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "version": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "mail": {
          ".validate": false
        },
        "$autre": {
          ".validate": false
        }
      }
    }
  }
}
