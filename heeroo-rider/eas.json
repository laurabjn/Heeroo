{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development",
        "STRIPE_PK_TEST": "pk_test_BeeF7JTRF8kOrTCBdPOTkE6r00u7U7w3dD"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "development",
        "STRIPE_PK_TEST": "pk_test_BeeF7JTRF8kOrTCBdPOTkE6r00u7U7w3dD"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "autoIncrement": false
    },
    "ios-simulator": {
      "extends": "production",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "autoIncrement": false
    }
  },
  "submit": {
    "production": {}
  }
}
