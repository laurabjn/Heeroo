# Ignorer le dossier node_modules partout dans le projet
**/node_modules/

# Ignorer les fichiers de log partout dans le projet
**/*.log
**/*.log.*

# Fichiers générés par l'OS (macOS)
**/.DS_Store
**/.swp

# iOS
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/*.xcodeproj/project.xcworkspace/
**/ios/*.xcuserdata/
**/ios/*.xcuserstate

# Android
**/android/.gradle/
**/android/app/build/
**/android/build/
**/android/.idea/
**/android/local.properties
**/android/*.iml

# Firebase (firebase.json et .firebaserc sont versionnés : ils décrivent le déploiement)
**/firebase-debug.log
**/firebase-debug.*
**/functions/node_modules/

# Bundler output files
**/index.android.bundle
**/index.ios.bundle

# Fichiers de build
**/build/
**/build/Release-iphoneos/
**/*.xcarchive
**/*.ipa
**/*.app

# Fichiers de configuration d'environnement
**/.env
# Clés Apple (App Store Connect API, notifications APNs) : jamais dans le dépôt
**/*.p8
**/AuthKey_*

**/*.keystore
**/*.jks
**/*.p12
**/*.mobileprovision
**/android/key.properties
**/.env.*

# Configurations spécifiques aux IDE (JetBrains, VS Code)
**/.idea/
**/.vscode/

# Documents client et exports (jamais dans le code)
/*.pdf
/*.json.bak
/export-*.json

# Fichiers de debug hérités contenant des données réelles
heeroo-rider/a.json
**/logs.txt

# Expo — les projets natifs sont générés au build (prebuild / CNG), jamais versionnés
**/.expo/
**/expo-env.d.ts
heeroo-rider/android/
heeroo-rider/ios/
heeroo-driver/android/
heeroo-driver/ios/
**/GoogleService-Info.plist.bak

# Secrets des fonctions pour l'émulateur (jamais versionnés)
**/.secret.local
**/.env.local

# Secrets de signature et de publication — ne doivent JAMAIS entrer dans Git.
# Le keystore d'upload est irremplaçable : le perdre interdit toute mise à jour
# des applications déjà publiées, et le diffuser permettrait à un tiers de
# signer une fausse mise à jour. La clé Apple (.p8) ouvre l'accès App Store
# Connect. Sauvegarde hors du dépôt, dans un gestionnaire de mots de passe.
heeroo-credentials/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision

# Livrables de build et éléments des magasins : lourds, régénérables, et sans
# intérêt dans l'historique (près d'un gigaoctet à eux deux).
heeroo-bundles/
heeroo-store/
*.aab
*.apk
